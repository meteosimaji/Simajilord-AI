# Local configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Python and build output
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
dist/
build/
*.egg-info/
.coverage
htmlcov/

# Editors, operating systems, logs, and temporary files
.DS_Store
.idea/
.vscode/
*.log
tmp/
temp/

# Local models and run state. These directories may contain private teachers,
# checkpoints, optimizer state, or sealed evaluation positions.
/artifacts/
/models/
/.data/

# Generated training corpora are local run artifacts, not source files.
# In particular, sealed final-test positions must never be published with the code.
/datasets/*
!/datasets/README.md

# Checkpoints and engine artifacts are published only as separately reviewed
# release artifacts after lineage, rights, and held-out gates have passed.
*.7z
*.bin
*.ckpt
*.csa
*.engine
*.hcpe
*.jsonl
*.ki2
*.kif
*.nn
*.npz
*.onnx
*.pb
*.psn
*.psv
*.pt
*.pth
*.safetensors
*.tflite
*.ybb
