# Never commit the real token or a cookie file.
DISCORD_TOKEN=replace-me
DISCORD_APPLICATION_ID=123456789012345678
# Message Content is the documented minimum and is always requested. Opt in to
# the other privileged Gateway intents only after enabling the matching toggles
# in Discord's Developer Portal; requesting an unavailable one closes the
# Gateway connection with code 4014.
DISCORD_MEMBERS_INTENT_ENABLED=false
DISCORD_PRESENCE_INTENT_ENABLED=false

# Optional official Discord Activity. The Activity is display-only and exposes
# the current audio state only after OAuth verification and same-VC checks.
# Keep the client secret exclusively in the real .env.
DISCORD_ACTIVITY_ENABLED=false
# DISCORD_CLIENT_SECRET=
DISCORD_ACTIVITY_HOST=127.0.0.1
DISCORD_ACTIVITY_PORT=8787

# Optional application emoji IDs. Startup verifies both each ID and its exact
# application emoji name; an unset, missing, or mismatched entry falls back to
# Unicode without blocking the BOT.
DISCORD_EMOJI_LOADING_ID=
DISCORD_EMOJI_SUCCESS_ID=
DISCORD_EMOJI_WARNING_ID=
DISCORD_EMOJI_AUDIO_WAVE_ID=
DISCORD_EMOJI_RADIO_ID=

# guild: synchronize commands to every connected guild for private development
# global: publish commands globally
COMMAND_SCOPE=guild
COMMAND_PREFIX=!

LOG_LEVEL=INFO
DATA_DIR=.data
# Private feedback reports are stored under DATA_DIR/feedback.sqlite3 and are
# inspected locally with `simajilord-feedback`; no GitHub write token is used.
# Owner-aware cleanup runs once at BOT startup. Active queues, pending image
# delivery, and in-progress timers are never removed.
DATA_RETENTION_DAYS=30
MAX_DATA_SIZE_GB=10

# Local speech synthesis. The example starts with the dependency-free macOS
# fallback. To use VOICEVOX, set TTS_PROVIDER=voicevox and either provide the
# engine path with auto-start enabled or run the loopback engine separately.
TTS_PROVIDER=macos
TTS_VOICE=Samantha
VOICEVOX_BASE_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=3
VOICEVOX_PRESET_CLEAR_ID=2
VOICEVOX_PRESET_CALM_ID=14
VOICEVOX_PRESET_ENERGETIC_ID=8
VOICEVOX_PRESET_CUTE_ID=3
VOICEVOX_PRESET_NARRATOR_ID=13
# VOICEVOX_ENGINE_PATH=/absolute/path/to/voicevox-engine/run
VOICEVOX_AUTO_START=false
VOICEVOX_TIMEOUT_SECONDS=30
VOICEVOX_READINESS_TTL_SECONDS=5
# Provider requests are split at this soft boundary; the message itself is not truncated.
READ_ALOUD_CHUNK_CHARACTERS=400
MAX_PENDING_SPEECH=20
MAX_PENDING_MUSIC=100
MAX_PENDING_MUSIC_PER_USER=20
MAX_CONCURRENT_TTS=2
MAX_CONCURRENT_TTS_PROVIDER_CALLS=2
# yt-dlp/provider jobs across all guilds, then per individual guild.
MAX_CONCURRENT_MEDIA=4
MAX_CONCURRENT_MEDIA_PER_GUILD=2

# One Discord voice connection is allowed per guild. This limit bounds the
# number of guilds that may be active at the same time.
MAX_ACTIVE_VOICE_GUILDS=8
DOWNLOAD_TIMEOUT_SECONDS=180
# Content-addressed Discord attachment playback. Files are verified with
# ffprobe and stay private under DATA_DIR/local_media.
LOCAL_MEDIA_MAX_FILE_BYTES=100000000
# Preferred human-readable cache ceiling. LOCAL_MEDIA_CACHE_BYTES remains a
# backwards-compatible override when LOCAL_MEDIA_SIZE_GB is unset.
LOCAL_MEDIA_SIZE_GB=5
LOCAL_MEDIA_MAX_DURATION_SECONDS=21600

# macOS on-device translation. A source checkout may build native/macos lazily.
# A wheel install has no bundled Mach-O helper: build it separately, run
# `chmod 700 /absolute/path/to/TranslationHelper`, and set the path below.
TRANSLATION_ENABLED=true
TRANSLATION_HELPER_PATH=
TRANSLATION_TIMEOUT_SECONDS=30
TRANSLATION_MAX_CHARACTERS=8000

# Optional. This is read directly; browser-cookie extraction is never used.
# Keep the file outside Git and run `chmod 600 /absolute/path/to/cookies.txt`.
# MEDIA_COOKIE_FILE=/absolute/path/to/cookies.txt

# Local-first Search / Fetch / Find. The default talks directly to the existing
# loopback SearXNG service. A remote backend must use HTTPS; keep its optional
# shared secret only in the real .env.
WEB_SEARCH_BASE_URL=http://127.0.0.1:8888
# WEB_SEARCH_SHARED_SECRET=
WEB_REQUEST_TIMEOUT_SECONDS=12
WEB_FETCH_MAX_BYTES=2000000

# HIVE Moderation V3 image/video detection. Successful results are cached by
# media SHA-256. Uncached attempts are atomically capped at 100 per UTC day.
# Keep the real bearer token only in .env.
# HIVE_API_KEY=
HIVE_DAILY_LIMIT=100
HIVE_TIMEOUT_SECONDS=90
HIVE_MAX_MEDIA_BYTES=25000000
HIVE_THRESHOLD=0.9

# GPT Image 2 generation uses the same saved Codex OAuth login as the agent.
# Agent requests wait for the generated file, inspect it in-turn, and choose
# whether to post it with discord.send_file; they are not auto-delivered.
IMAGE_TIMEOUT_SECONDS=600
IMAGE_GENERATION_ACCESS=disabled
IMAGE_PER_USER_REQUESTS=5
IMAGE_PER_USER_WINDOW_SECONDS=3600
IMAGE_PER_WORKSPACE_REQUESTS=30
IMAGE_PER_WORKSPACE_WINDOW_SECONDS=86400
IMAGE_MAX_PENDING_JOBS=10

# Event-driven AI. Mentions and autonomous checks share one provider API; there
# is intentionally no /ask command. Keep the feature disabled until the guild
# allowlist has been reviewed.
AGENT_ENABLED=false
AGENT_ALLOWED_GUILD_IDS=

# This compatibility allowlist never widens message visibility. Mention-driven
# reads always require both the active requester and BOT to have live View
# Channel and Read Message History access (plus private-thread membership).
# Reads and explicitly requested writes may target another server shared by the
# requester and BOT. Every target re-checks both parties' live permissions;
# cached history or membership alone never authorizes a write.
AGENT_TRUSTED_GUILD_IDS=
AGENT_ADMIN_USER_IDS=
# Exact Discord user IDs here bypass local AI request/token guards. Keep this
# separate from feature administrators so future admins are not unlimited.
AGENT_RATE_LIMIT_EXEMPT_USER_IDS=

AGENT_PROVIDER=codex
AGENT_MODEL=gpt-5.6-luna
AGENT_ESCALATION_MODEL=gpt-5.6-terra
CODEX_EXECUTABLE=codex
AGENT_REASONING_EFFORT=high
# This is an inactivity watchdog, not a total turn limit. Model reasoning,
# streamed output, follow-ups, and tool activity refresh it; each long-running
# capability also retains its own declared timeout.
AGENT_IDLE_TIMEOUT_SECONDS=600

# Optional capabilities use explicit policies: disabled, admins, or everyone.
# When granted, web access exposes both Codex first-party search and the local
# web.search/web.fetch/web.find capabilities. Human /web commands use the same
# local web service independently of the model grant.
AGENT_WEB_SEARCH_ACCESS=disabled
# Safe compute requires AGENT_FILE_SANDBOX_ENABLED=true. It accepts only
# argv-based Python scripts already written to the per-server file workspace;
# host files, shell strings, child processes, and network access stay blocked.
AGENT_SAFE_COMPUTE_ACCESS=disabled
AGENT_FILE_SANDBOX_ENABLED=false
# Enables only Simajilord's package-owned, tool-only workflow catalog. It never
# loads Codex user/global skills, plugins, MCP tools, shell steps, or host paths.
AGENT_CURATED_SKILLS_ENABLED=false

# Local request/token guards. Capability results remain bounded per call, but
# one turn is not stopped by an arbitrary aggregate tool-call/output counter.
AGENT_PER_USER_REQUESTS=3
AGENT_PER_USER_WINDOW_SECONDS=600
AGENT_PER_WORKSPACE_REQUESTS=10
AGENT_PER_WORKSPACE_WINDOW_SECONDS=3600
AGENT_MAX_TOKENS_PER_24_HOURS=150000
# Total host-returned answer budget. The model receives this value before each
# turn and can choose semantic multi-message breaks or another delivery route.
AGENT_MAX_RESPONSE_CHARACTERS=7600
MAX_ACTIVE_AGENT_TURNS=4
# Waiting turns only; active provider work is bounded separately above.
MAX_PENDING_AGENT_TURNS=20
# Waiting turns per user only; active turns do not consume this allowance.
# The same numeric setting separately bounds accepted steer follow-ups per user.
MAX_PENDING_AGENT_TURNS_PER_USER=2

# Autonomy is inert until AGENT_ENABLED is true and this explicit guild
# allowlist contains a server from AGENT_ALLOWED_GUILD_IDS.
# observe disables spontaneous turns; assist can answer/react/remind; act uses
# every otherwise granted capability subject to live permissions and rate
# limits. Set AGENT_AUTONOMY_MAX_RUNS above zero only for bounded tests.
AGENT_AUTONOMY_ENABLED=true
AGENT_AUTONOMY_GUILD_IDS=
# observe, assist, or act
AGENT_AUTONOMY_MODE=act
# Same-channel events are grouped for 5 to 15 seconds.
AGENT_AUTONOMY_BATCH_SECONDS=10
# 0 means no artificial run-count cutoff.
AGENT_AUTONOMY_MAX_RUNS=0
# Maximum oldest events passed from one channel to one turn; excess stays queued.
AGENT_AUTONOMY_CANDIDATE_LIMIT=5
AGENT_AUTONOMY_MAX_PENDING_EVENTS=1000
AGENT_AUTONOMY_MAX_PENDING_EVENTS_PER_CHANNEL=100
# Human gateway events only; timer/audio/external system events are not charged here.
AGENT_AUTONOMY_MAX_PENDING_EVENTS_PER_ACTOR=50
